# 默认：由 Git 自动识别文本文件，仓库内统一存 LF
* text=auto

# 源码与文档一律 LF
*.py    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
.gitignore text eol=lf

# Windows 批处理与 VBScript 必须保留 CRLF，否则可能无法执行
*.bat   text eol=crlf
*.vbs   text eol=crlf
*.cmd   text eol=crlf

# 二进制，不做任何换行转换
*.ico   binary
*.exe   binary
*.png   binary
